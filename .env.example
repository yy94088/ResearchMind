# 仅用于本地开发。复制为 .env 后请替换成你自己的强密码。
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_PASSWORD=replace-with-a-strong-app-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
# 使用 `openssl rand -base64 48` 生成，不少于 32 字节。
JWT_SECRET=replace-with-a-base64-encoded-random-secret
# MinIO 本地对象存储。用户名至少 3 个字符，密码至少 8 个字符。
MINIO_ROOT_USER=researchmind
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
# DeepSeek 密钥仅供 Spring Boot 后端读取，禁止写入前端 VITE_* 变量。
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Java 进程无法直连 DeepSeek 时填写本机 HTTP 代理，例如 http://127.0.0.1:7897。
# 留空时后端会依次尝试读取 HTTPS_PROXY / https_proxy 环境变量。
DEEPSEEK_PROXY_URL=

# 可选：真实密码找回邮件。未配置时保持 false，接口会明确提示管理员尚未启用。
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000/login
PASSWORD_RESET_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# 现有数据库首次启用系统管理时，可填写一个已注册且启用的账户邮箱。
# 系统已有 ADMIN 后该配置不会再改变任何用户角色。
INITIAL_ADMIN_EMAIL=
